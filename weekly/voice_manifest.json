   "start": 440.902,
   "duration": 3.79,
   "file": "voice/cache/f524e0597258547e.wav"
  },
  {
   "scene": "weekly_17",
   "cue": 3,
   "kind": "normal",
   "text": "Abonniere Deutsch mit Farsi für die nächste Lektion.",
   "length_scale": 1.12,
   "start": 445.292,
   "duration": 2.613,
   "file": "voice/cache/410375f1ec86aa36.wav"
  },
  {
   "scene": "weekly_17",
   "cue": 4,
   "kind": "normal",
   "text": "Jeden Tag einen Schritt näher an die deutsche Sprache.",
   "length_scale": 1.12,
