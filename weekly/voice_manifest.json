   "start": 227.043,
   "duration": 1.721,
   "file": "voice/cache/d958ecb36e7003d7.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 1,
   "kind": "normal",
   "text": "Guten Morgen! Was möchten Sie?",
   "length_scale": 1.12,
   "start": 229.563,
   "duration": 1.815,
   "file": "voice/cache/6b5a7f148fbd7f69.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 2,
   "kind": "normal",
   "text": "Guten Morgen! Ich hätte gern zwei Brötchen und einen Kaffee, bitte.",
   "length_scale": 1.12,
   "start": 232.128,
   "duration": 4.11,
   "file": "voice/cache/6d29b6517de9ba90.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 3,
   "kind": "normal",
   "text": "Zum Mitnehmen?",
   "length_scale": 1.12,
   "start": 236.988,
   "duration": 0.949,
   "file": "voice/cache/d91135b7eb4f9d27.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 4,
   "kind": "normal",
   "text": "Ja, bitte. Was kostet das zusammen?",
   "length_scale": 1.12,
   "start": 238.687,
   "duration": 2.821,
   "file": "voice/cache/3a1a5461bd68a137.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 5,
   "kind": "normal",
   "text": "Einen Moment, bitte.",
   "length_scale": 1.12,
   "start": 242.258,
   "duration": 1.058,
   "file": "voice/cache/8caea3e03671619b.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 6,
   "kind": "normal",
   "text": "Kann ich mit Karte zahlen?",
   "length_scale": 1.12,
   "start": 244.066,
   "duration": 1.227,
   "file": "voice/cache/8aa9ac1617161224.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 7,
   "kind": "normal",
   "text": "Ja. Sonst noch etwas?",
   "length_scale": 1.12,
   "start": 246.043,
   "duration": 1.69,
   "file": "voice/cache/2792af8689434d6c.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 8,
   "kind": "normal",
   "text": "Nein, danke. Das ist alles.",
   "length_scale": 1.12,
   "start": 248.483,
   "duration": 2.412,
   "file": "voice/cache/e3a4d20d92757326.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 0,
   "kind": "normal",
   "text": "Jetzt bist du der Kunde.",
   "length_scale": 1.12,
   "start": 252.895,
   "duration": 0.926,
   "file": "voice/cache/b853612894cff467.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 1,
   "kind": "normal",
   "text": "Ich stelle die Fragen.",
   "length_scale": 1.12,
   "start": 254.421,
   "duration": 0.881,
   "file": "voice/cache/88399f995a608fb1.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 2,
   "kind": "normal",
   "text": "Antworte laut.",
   "length_scale": 1.12,
   "start": 255.902,
   "duration": 0.841,
   "file": "voice/cache/346025f769fe76a7.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 3,
   "kind": "normal",
   "text": "Guten Morgen! Was möchten Sie?",
   "length_scale": 1.12,
   "start": 257.543,
   "duration": 1.815,
   "file": "voice/cache/6b5a7f148fbd7f69.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 4,
   "kind": "normal",
   "text": "Zum Mitnehmen oder hier trinken?",
   "length_scale": 1.12,
   "start": 265.508,
   "duration": 1.644,
   "file": "voice/cache/45026fcd5ba91413.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 5,
   "kind": "normal",
   "text": "Sonst noch etwas?",
