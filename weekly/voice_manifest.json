   "start": 219.488,
   "duration": 2.02,
   "file": "voice/cache/a23249018a34fee7.wav"
  },
  {
   "scene": "weekly_09",
   "cue": 6,
   "kind": "normal",
   "text": "Wähle einen freundlichen Abschluss, der für dich natürlich klingt.",
   "length_scale": 1.12,
   "start": 222.108,
   "duration": 2.935,
   "file": "voice/cache/01dfc5d22d6fdb07.wav"
  },
  {
   "scene": "weekly_10",
   "cue": 0,
   "kind": "normal",
   "text": "Höre jetzt unser ganzes Beispiel.",
