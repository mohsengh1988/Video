   "file": "voice/cache/6fb419f8b0b8a60d.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 1,
   "kind": "normal",
   "text": "Heute fahren wir mit der U-Bahn.",
   "length_scale": 1.12,
   "start": 296.325,
   "duration": 1.456,
   "file": "voice/cache/71e609eb277ed1db.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 2,
   "kind": "normal",
   "text": "Unser Satz lautet:",
   "length_scale": 1.12,
   "start": 298.381,
   "duration": 0.996,
   "file": "voice/cache/be63c52645dc7120.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 3,
   "kind": "normal",
   "text": "Ich fahre mit der U-Bahn zur Arbeit.",
   "length_scale": 1.15,
   "start": 299.677,
   "duration": 1.487,
   "file": "voice/cache/09c6647fb1cdf605.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 3,
   "kind": "slow_repeat",
   "text": "Ich fahre mit der U-Bahn zur Arbeit.",
   "length_scale": 1.6,
   "start": 301.864,
   "duration": 1.761,
   "file": "voice/cache/b7a1a4af6df18645.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 4,
   "kind": "normal",
   "text": "Zur Arbeit beschreibt das Ziel.",
   "length_scale": 1.12,
   "start": 308.225,
   "duration": 1.462,
   "file": "voice/cache/2e09038df981e7f0.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 5,
   "kind": "normal",
   "text": "Mit der U-Bahn beschreibt das Verkehrsmittel.",
