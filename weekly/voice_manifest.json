  },
  {
   "scene": "weekly_11",
   "cue": 6,
   "kind": "normal",
   "text": "Sehr gut.",
   "length_scale": 1.12,
   "start": 280.519,
   "duration": 0.538,
   "file": "voice/cache/c2320ba700ad9ff6.wav"
  },
  {
