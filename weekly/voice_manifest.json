   "duration": 2.537,
   "file": "voice/cache/24c25e080fe083d4.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 8,
   "kind": "normal",
   "text": "Ich hätte gern zwei Brötchen und einen Kaffee, bitte.",
   "length_scale": 1.12,
   "start": 284.794,
   "duration": 2.681,
   "file": "voice/cache/22df3139cef37e96.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 9,
   "kind": "normal",
   "text": "Zum Mitnehmen, bitte.",
   "length_scale": 1.12,
   "start": 288.075,
   "duration": 1.275,
   "file": "voice/cache/0751ab4eed9a54bb.wav"
  },
  {
   "scene": "weekly_11",
   "cue": 10,
   "kind": "normal",
   "text": "Nein, danke. Das ist alles.",
   "length_scale": 1.12,
   "start": 289.95,
   "duration": 2.412,
   "file": "voice/cache/e3a4d20d92757326.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 0,
   "kind": "normal",
   "text": "Wir gehen weiter zur Arbeit.",
