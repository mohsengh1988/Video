   "start": 312.988,
   "duration": 2.732,
   "file": "voice/cache/bfa5aff2c3153180.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 7,
   "kind": "normal",
   "text": "Oder: Ich gehe zu Fuß zur Arbeit.",
   "length_scale": 1.12,
   "start": 316.32,
   "duration": 2.035,
   "file": "voice/cache/6615f2c4f0ab56d6.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 0,
   "kind": "normal",
   "text": "Wenn du die Richtung nicht kennst, frage:",
   "length_scale": 1.12,
   "start": 320.355,
   "duration": 1.786,
   "file": "voice/cache/7b651af7be435f8d.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 1,
   "kind": "normal",
   "text": "Entschuldigung, wo ist die U-Bahn?",
   "length_scale": 1.15,
   "start": 322.441,
   "duration": 1.994,
   "file": "voice/cache/9b4f589111c1e4c2.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 1,
   "kind": "slow_repeat",
   "text": "Entschuldigung, wo ist die U-Bahn?",
   "length_scale": 1.6,
   "start": 325.134,
   "duration": 2.397,
   "file": "voice/cache/ed1062d13a790448.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 2,
   "kind": "normal",
   "text": "Entschuldigung ist ein höflicher Einstieg.",
   "length_scale": 1.12,
   "start": 332.281,
   "duration": 1.948,
   "file": "voice/cache/0f6212c116e8287e.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 3,
   "kind": "normal",
   "text": "Eine mögliche Antwort lautet: Geradeaus und dann rechts.",
