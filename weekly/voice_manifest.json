   "start": 310.287,
   "duration": 2.101,
   "file": "voice/cache/3f75489494ec646b.wav"
  },
  {
   "scene": "weekly_12",
   "cue": 6,
   "kind": "normal",
   "text": "Du kannst auch sagen: Ich fahre mit dem Bus zur Arbeit.",
