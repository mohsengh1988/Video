   "start": 334.829,
   "duration": 3.119,
   "file": "voice/cache/cd67dfff65a85917.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 4,
   "kind": "normal",
   "text": "Geradeaus bedeutet:",
   "length_scale": 1.12,
   "start": 338.548,
   "duration": 1.071,
   "file": "voice/cache/de1c025b92c6bf53.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 5,
   "kind": "normal",
   "text": "Rechts bedeutet:",
   "length_scale": 1.12,
   "start": 341.719,
   "duration": 0.906,
   "file": "voice/cache/6ee0630cad9d565e.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 6,
   "kind": "normal",
   "text": "Links bedeutet:",
   "length_scale": 1.12,
   "start": 344.726,
   "duration": 0.795,
   "file": "voice/cache/c661ab61b1fd85ef.wav"
  },
  {
   "scene": "weekly_13",
   "cue": 7,
   "kind": "normal",
   "text": "Diese Wegbeschreibung ist nur ein Übungsbeispiel und keine echte Route.",
   "length_scale": 1.12,
   "start": 347.62,
   "duration": 3.987,
   "file": "voice/cache/89160cc91652fae3.wav"
  },
  {
   "scene": "weekly_14",
   "cue": 0,
   "kind": "normal",
   "text": "Du kommst an und sagst: Guten Morgen! Wie geht es dir?",
   "length_scale": 1.12,
   "start": 353.607,
   "duration": 3.35,
   "file": "voice/cache/7c648378773c5a64.wav"
  },
  {
   "scene": "weekly_14",
   "cue": 1,
   "kind": "normal",
   "text": "Bei einer Person, die du siezt, heißt die Frage: Wie geht es Ihnen?",
   "length_scale": 1.12,
   "start": 357.707,
   "duration": 4.002,
   "file": "voice/cache/d94a11cd2431aeb6.wav"
  },
  {
   "scene": "weekly_14",
   "cue": 2,
   "kind": "normal",
   "text": "Du kannst antworten: Gut, danke. Und dir?",
   "length_scale": 1.12,
   "start": 362.459,
   "duration": 3.207,
   "file": "voice/cache/4cfaf634aee8fd46.wav"
  },
  {
   "scene": "weekly_14",
   "cue": 3,
   "kind": "normal",
   "text": "Oder höflich: Und Ihnen?",
   "length_scale": 1.12,
   "start": 366.415,
   "duration": 1.418,
   "file": "voice/cache/b323cea64b2583e2.wav"
  },
  {
   "scene": "weekly_14",
   "cue": 4,
   "kind": "normal",
   "text": "Ob du du oder Sie verwendest, hängt von der Person und der Situation ab.",
   "length_scale": 1.12,
   "start": 368.583,
   "duration": 3.844,
   "file": "voice/cache/c5b3f94e6fcfb059.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 0,
   "kind": "normal",
   "text": "Du hast etwas nicht verstanden. Sage:",
   "length_scale": 1.12,
   "start": 374.427,
   "duration": 2.342,
   "file": "voice/cache/0d0ae121d0c385df.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 1,
   "kind": "normal",
   "text": "Können Sie das bitte wiederholen?",
   "length_scale": 1.15,
   "start": 377.069,
   "duration": 1.356,
   "file": "voice/cache/3d76cf757de80950.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 1,
   "kind": "slow_repeat",
   "text": "Können Sie das bitte wiederholen?",
   "length_scale": 1.6,
   "start": 379.125,
   "duration": 1.614,
   "file": "voice/cache/46791a1d489d6d45.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 2,
   "kind": "normal",
   "text": "Oder: Können Sie bitte langsamer sprechen?",
   "length_scale": 1.12,
   "start": 385.489,
   "duration": 2.142,
   "file": "voice/cache/fb21373e27507bc9.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 3,
   "kind": "normal",
   "text": "Nachfragen ist Teil des Lernens.",
   "length_scale": 1.12,
   "start": 388.382,
   "duration": 1.645,
   "file": "voice/cache/39ab6b7fe37d2240.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 4,
   "kind": "normal",
   "text": "Du musst kein Verständnis vortäuschen.",
   "length_scale": 1.12,
   "start": 390.627,
   "duration": 1.891,
   "file": "voice/cache/febbc8a404b712a4.wav"
  },
  {
   "scene": "weekly_15",
   "cue": 5,
   "kind": "normal",
   "text": "Diese beiden Sätze helfen dir in vielen Gesprächen, nicht nur bei der Arbeit.",
   "length_scale": 1.12,
   "start": 393.118,
   "duration": 4.098,
   "file": "voice/cache/ae4e50a83dc6c73d.wav"
  },
  {
   "scene": "weekly_16",
   "cue": 0,
   "kind": "normal",
   "text": "Ein kurzes Quiz.",
   "length_scale": 1.12,
   "start": 399.216,
   "duration": 0.942,
   "file": "voice/cache/84696838241811cd.wav"
  },
  {
   "scene": "weekly_16",
   "cue": 1,
   "kind": "normal",
   "text": "Du möchtest einen Kaffee höflich bestellen.",
   "length_scale": 1.12,
