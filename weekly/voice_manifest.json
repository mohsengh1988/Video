  {
   "scene": "weekly_09",
   "cue": 1,
   "kind": "normal",
   "text": "Diese Frage bedeutet: Möchtest du noch etwas bestellen?",
   "length_scale": 1.12,
   "start": 199.526,
   "duration": 2.831,
   "file": "voice/cache/b35ed246d9e4009f.wav"
  },
  {
   "scene": "weekly_09",
   "cue": 2,
   "kind": "normal",
   "text": "Wenn du fertig bist, antwortest du:",
   "length_scale": 1.12,
   "start": 203.107,
   "duration": 1.905,
   "file": "voice/cache/fd58380be0aa2053.wav"
  },
  {
   "scene": "weekly_09",
   "cue": 3,
   "kind": "normal",
   "text": "Nein, danke. Das ist alles.",
   "length_scale": 1.15,
   "start": 205.312,
   "duration": 2.39,
   "file": "voice/cache/07c3337b366e48dc.wav"
  },
  {
   "scene": "weekly_09",
   "cue": 3,
   "kind": "slow_repeat",
   "text": "Nein, danke. Das ist alles.",
   "length_scale": 1.6,
   "start": 208.401,
   "duration": 3.064,
   "file": "voice/cache/75ab3a5d7d4b0bf4.wav"
  },
  {
   "scene": "weekly_09",
   "cue": 4,
   "kind": "normal",
   "text": "Danach: Vielen Dank! Einen schönen Tag noch!",
   "length_scale": 1.12,
   "start": 216.065,
